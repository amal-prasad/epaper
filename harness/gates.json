{
  "gates": [
    {
      "id": "G0.parity",
      "phase": 0,
      "status": "active",
      "title": "Line-break parity vs real DOM on real Hindi copy, launch fonts (fonts.json launch:true), percent",
      "run": "npm --prefix spike run spike",
      "metricFile": "spike/out/report.json",
      "metricKey": "pct",
      "op": ">=",
      "threshold": 95,
      "target": 99.5,
      "slow": true,
      "also": [
        {
          "key": "realParagraphs",
          "op": ">=",
          "threshold": 40,
          "why": "measure on 40+ real Janshakti paragraphs, not invented text"
        },
        {
          "key": "inventedParagraphs",
          "op": "<=",
          "threshold": 0,
          "why": "delete spike/samples/news-sample.txt (invented text)"
        },
        {
          "key": "longerThanDom",
          "op": "<=",
          "threshold": 0,
          "why": "Pretext must never fit more on a line than the browser: that text would run past the column in print"
        }
      ]
    },
    {
      "id": "G0.guard",
      "phase": 0,
      "status": "active",
      "title": "Repo guardrail tests failing (brand name, licences)",
      "run": "node harness/run-tests.mjs",
      "metricFile": "harness/results/tests.json",
      "metricKey": "failed",
      "op": "<=",
      "threshold": 0
    },
    {
      "id": "G0.flow",
      "phase": 0,
      "status": "active",
      "title": "flow() tests passing: the 12 contract tests in conservation.test.js plus at least 5 of your own in flow*.test.js, none skipped",
      "run": "node harness/run-tests.mjs",
      "metricFile": "harness/results/tests.json",
      "metricKey": "flowPassed",
      "op": ">=",
      "threshold": 17,
      "also": [
        {
          "key": "flowSkipped",
          "op": "<=",
          "threshold": 0,
          "why": "skipped flow tests do not count; flow.js must exist"
        }
      ]
    },
