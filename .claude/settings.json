{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run harness*)",
      "Bash(npm run ux)",
      "Bash(node harness/run.mjs*)",
      "Bash(node harness/run-tests.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git commit*--no-verify*)",
      "Bash(npm run approve*)",
      "Bash(npm run record*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-gates.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context-mode@context-mode": false,
    "ralph-loop@claude-plugins-official": false,
    "everything-claude-code@everything-claude-code": false,
    "superpowers@superpowers-dev": false,
    "claude-md-management@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": false,
    "claude-seo@agricidaniel-claude-seo": false,
    "atomic-agents@claude-plugins-official": false,
    "warp@claude-code-warp": false
  }
}
